# /etc/alertd/alertd.env — права 600, власник root.
# Після змін: sudo systemctl restart alertd

# Токен API ukrainealarm (https://api.ukrainealarm.com, видається після реєстрації).
UA_TOKEN=

# Секрет у шляху webhook. alertd-install.sh генерує його сам (48 hex-символів).
HOOK_SECRET=

# Публічна HTTPS-адреса, яку викликатиме ukrainealarm. Має закінчуватися на /hook/$HOOK_SECRET.
# Домен — ваш; HTTPS забезпечує reverse proxy (Caddy, nginx тощо), див. docs/proxy.md.
PUBLIC_HOOK_URL=https://alerts.example.com/hook/ВСТАВТЕ_HOOK_SECRET

# Де слухати. Webhook — за reverse proxy; локальний API — лише для цього сервера (лише loopback).
HOOK_LISTEN=127.0.0.1:8787
LOCAL_LISTEN=127.0.0.1:8788

DB_PATH=/var/lib/alertd/alerts.db

# Частота опитування API: раз на POLL_INTERVAL alertd бере повний знімок /alerts і звіряє
# з ним стан (так виправляються пропущені webhook). Менше значення — швидше виправлення,
# але більше запитів. Ліміт ukrainealarm — близько 1 запиту на хвилину на токен, тому
# між будь-якими запитами alertd витримує щонайменше API_MIN_GAP (не ставте менше 60s).
# Типово — найчастіше з можливого: POLL_INTERVAL = API_MIN_GAP.
POLL_INTERVAL=61s
API_MIN_GAP=61s

# Допустима різниця часу підпису (рекомендація ukrainealarm — 5 хвилин).
MAX_SKEW=5m

# Скільки зберігати журнал подій. Сесії тривог і поточний стан не чистяться.
RETENTION=4320h

# 1 — писати кожну зміну стану в журнал systemd.
LOG_EVENTS=1

# Ключ підпису ukrainealarm, закріплений файлом (сервер ключа часто відповідає 403
# на запити з хостингів). Якщо підпис не сходиться, alertd пробує взяти новий ключ з API.
PUBKEY_FILE=/etc/alertd/webhook-public.pem

# Назва вкладки браузера на публічних сторінках. Порожньо — нейтральний заголовок сторінки.
SITE_TITLE=
